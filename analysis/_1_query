## query number of enrollees per year per fips
## filename: _fips_num_enroll.csv

```
SELECT 
    year, fips5, count(bene_id)
FROM 
    medicare.enrollments
WHERE 
    year in ('2011', '2012', '2013', '2014', '2016', '2017') AND
    state = 'NC'
GROUP BY 
    year,  
    fips5
;
```

## query number of enrollees per year per fips stratified by race
## filename: fips_num_enroll.csv

```
SELECT 
    medicare.enrollments.year, medicare.enrollments.fips5, medicare.beneficiaries.race, count(medicare.enrollments.bene_id)
FROM 
    medicare.enrollments
LEFT JOIN medicare.beneficiaries ON medicare.enrollments.bene_id = medicare.beneficiaries.bene_id
WHERE 
    medicare.enrollments.year in ('2011', '2012', '2013', '2014', '2016', '2017') AND
    medicare.enrollments.state = 'NC'
GROUP BY 
    medicare.enrollments.year,  
    medicare.enrollments.fips5, 
    medicare.beneficiaries.race
;
```

